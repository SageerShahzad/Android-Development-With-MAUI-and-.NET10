<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ClassifiedAds.Mobile.ViewModels"
             x:Class="ClassifiedAds.Mobile.Views.FilterPage"
             BackgroundColor="White"
             Title="Filter">

    <Grid RowDefinitions="Auto, *, Auto" Padding="0">

        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="20,20,20,10">
            <Label Text="Filters" 
                   FontSize="28" 
                   FontAttributes="Bold" 
                   TextColor="Black"
                   VerticalOptions="Center"/>

            <Button Grid.Column="1"
                    Text="Reset"
                    Command="{Binding ResetFiltersCommand}"
                    TextColor="#6200EE"
                    BackgroundColor="Transparent"
                    FontAttributes="Bold"
                    Padding="0"
                    HeightRequest="40"/>
        </Grid>

        <ScrollView Grid.Row="1" Padding="20,0">
            <VerticalStackLayout Spacing="25">

                <VerticalStackLayout Spacing="8">
                    <Label Text="Category" FontAttributes="Bold" TextColor="#333"/>
                    <Border StrokeThickness="0" BackgroundColor="#F5F6F8" StrokeShape="RoundRectangle 12" HeightRequest="50" Padding="15,0">
                        <Grid>
                            <Grid ColumnDefinitions="*, 30" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="{Binding CategoryDisplayText}" TextColor="{Binding CategoryTextColor}" VerticalOptions="Center" LineBreakMode="TailTruncation"/>
                                <Label Grid.Column="1" Text="▼" TextColor="Gray" VerticalOptions="Center" HorizontalOptions="Center" FontSize="12"/>
                            </Grid>

                            <Picker ItemsSource="{Binding Categories}" 
                                    SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                    Title="Select Category"
                                    TextColor="Transparent"
                                    TitleColor="Transparent"
                                    BackgroundColor="Transparent"
                                    Opacity="0.01"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Country" FontAttributes="Bold" TextColor="#333"/>
                    <Border StrokeThickness="0" BackgroundColor="#F5F6F8" StrokeShape="RoundRectangle 12" HeightRequest="50" Padding="15,0">
                        <Grid>
                            <Grid ColumnDefinitions="*, 30" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="{Binding CountryDisplayText}" TextColor="{Binding CountryTextColor}" VerticalOptions="Center" LineBreakMode="TailTruncation"/>
                                <Label Grid.Column="1" Text="▼" TextColor="Gray" VerticalOptions="Center" HorizontalOptions="Center" FontSize="12"/>
                            </Grid>

                            <Picker ItemsSource="{Binding Countries}" 
                                    SelectedItem="{Binding SelectedCountry, Mode=TwoWay}"
                                    Title="Select Country"
                                    TextColor="Transparent"
                                    TitleColor="Transparent"
                                    BackgroundColor="Transparent"
                                    Opacity="0.01"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="City" FontAttributes="Bold" TextColor="#333"/>
                    <Border StrokeThickness="0" BackgroundColor="#F5F6F8" StrokeShape="RoundRectangle 12" HeightRequest="50" Padding="15,0">
                        <Grid>
                            <Grid ColumnDefinitions="*, 30" VerticalOptions="Center">
                                <Label Grid.Column="0" 
                                       Text="{Binding CityDisplayText}" 
                                       TextColor="{Binding CityTextColor}" 
                                       VerticalOptions="Center" 
                                       LineBreakMode="TailTruncation"/>
                                <Label Grid.Column="1" 
                                       Text="▼" 
                                       TextColor="Gray" 
                                       VerticalOptions="Center" 
                                       HorizontalOptions="Center" 
                                       FontSize="12"/>
                            </Grid>

                            <Picker ItemsSource="{Binding Cities}" 
                                    SelectedItem="{Binding SelectedCity, Mode=TwoWay}" 
                                    Title="Select City" 
                                    TextColor="Transparent" 
                                    TitleColor="Transparent" 
                                    BackgroundColor="Transparent" 
                                    Opacity="0.01" 
                                    HorizontalOptions="Fill" 
                                    VerticalOptions="Fill"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Postal Code" FontAttributes="Bold" TextColor="#333"/>
                    <Border StrokeThickness="0" BackgroundColor="#F5F6F8" StrokeShape="RoundRectangle 12" HeightRequest="50" Padding="15,0">
                        <Entry Placeholder="Enter postal code" 
                               Text="{Binding PostalCodeFilter}" 
                               TextColor="Black" 
                               PlaceholderColor="Gray" 
                               VerticalOptions="Center"/>
                    </Border>
                </VerticalStackLayout>

                <BoxView HeightRequest="20" />
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="2" Padding="20" StrokeThickness="0" BackgroundColor="White" Shadow="{Shadow Brush=Black, Opacity=0.1, Radius=10, Offset='0,-5'}">
            <VerticalStackLayout Spacing="10">
                <Button Text="Show Results" 
                        Clicked="OnApplyClicked" 
                        BackgroundColor="Black" 
                        TextColor="White" 
                        CornerRadius="25" 
                        HeightRequest="50" 
                        FontAttributes="Bold"/>
                <Button Text="Cancel" 
                        Clicked="OnCloseClicked" 
                        BackgroundColor="Transparent" 
                        TextColor="Gray" 
                        HeightRequest="40"/>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>