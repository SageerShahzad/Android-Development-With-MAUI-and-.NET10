<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ClassifiedAds.Mobile.ViewModels"
             x:Class="ClassifiedAds.Mobile.Views.AdDetailPage"
             Title="{Binding Title}"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <Grid HeightRequest="300" BackgroundColor="Black">
                <Image Source="{Binding MainImageUrl}"
                       Aspect="AspectFill"
                       HorizontalOptions="Fill"
                       VerticalOptions="Fill"/>
            </Grid>

            <Border Margin="15, -30, 15, 15" 
                    Padding="20"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 20">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.1" Radius="10" Offset="0,5"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="15">

                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding Category}" 
                               FontSize="12" 
                               TextColor="#6200EE" 
                               FontAttributes="Bold"
                               TextTransform="Uppercase"/>

                        <Label Text="{Binding CreatedDate, StringFormat='Posted on {0:MMM dd, yyyy}'}" 
                               FontSize="12" 
                               TextColor="Gray"/>
                    </VerticalStackLayout>

                    <Label Text="{Binding Title}" 
                           FontSize="26" 
                           FontAttributes="Bold" 
                           TextColor="Black"
                           LineHeight="1.1"/>

                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                        <Label Grid.Column="0" 
                               Text="Price" 
                               FontSize="12" 
                               TextColor="Gray"/>

                        <Label Grid.Column="0" 
                               Grid.Row="1"
                               Text="{Binding Price, StringFormat='{0:C}'}" 
                               FontSize="28" 
                               TextColor="#00C853" 
                               FontAttributes="Bold"/>

                       
                    </Grid>

                    <BoxView HeightRequest="1" Color="#E0E0E0" />

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="📍" VerticalOptions="Center"/>
                        <VerticalStackLayout>
                            <Label Text="{Binding City}" FontAttributes="Bold" FontSize="14" TextColor="Gray"/>
                            <Label Text="{Binding Country}" FontSize="12" TextColor="Gray"/>
                        </VerticalStackLayout>

                        <Label Text="|" TextColor="#E0E0E0" Margin="10,0"/>

                        <Label Text="👤" VerticalOptions="Center"/>
                        <VerticalStackLayout>
                            <Label Text="{Binding MemberId}" FontAttributes="Bold" FontSize="14" TextColor="Gray"/>
                            <Label Text="Advertiser" FontSize="12" TextColor="Gray"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="1" Color="#E0E0E0" />

                    <Label Text="Description" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           TextColor="Black"/>

                    <Label Text="{Binding Description}" 
                           FontSize="15" 
                           TextColor="#424242"
                           LineHeight="1.5"/>

                    

                </VerticalStackLayout>
            </Border>

            <Button Text="Contact Advertiser"
                    Command="{Binding ContactSellerCommand}"
                    BackgroundColor="Black"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="25"
                    HeightRequest="50"
                    Margin="20,0,20,30" 
                    Shadow="{Shadow Brush=Black, Opacity=0.2, Radius=5, Offset='0,4'}"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>