<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ClassifiedAds.Mobile.ViewModels"
             x:Class="ClassifiedAds.Mobile.Views.MessageThreadPage"
             Title="Messages"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="*, Auto" 
          Padding="{OnPlatform Android='0,0,0,40', Default='0'}">
        <!-- Bottom padding for Android nav bar; adjust if needed -->

        <CollectionView x:Name="MessagesList"
                        Grid.Row="0"
                        ItemsSource="{Binding Messages}"
                        ItemsLayout="VerticalList"
                        Margin="0,0,0,10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10,5">
                        <HorizontalStackLayout HorizontalOptions="{Binding Alignment}" Spacing="8">

                            <Grid VerticalOptions="End" 
                                  IsVisible="{Binding IsMine, Converter={StaticResource InvertedBoolConverter}}">

                                <Border StrokeShape="Ellipse"
                                        HeightRequest="40"
                                        WidthRequest="40"
                                        StrokeThickness="0"
                                        BackgroundColor="#E0E0E0">
                                    <Image Aspect="AspectFill" HeightRequest="40" WidthRequest="40">
                                        <Image.Source>
                                            <UriImageSource Uri="{Binding SenderImageUrl}" 
                                                            CachingEnabled="True" 
                                                            CacheValidity="14:00:00:00"/>
                                        </Image.Source>
                                    </Image>
                                </Border>

                                <Border BackgroundColor="#4CAF50"
                                        Stroke="White"
                                        StrokeThickness="2"
                                        HeightRequest="14"
                                        WidthRequest="14"
                                        StrokeShape="Ellipse"
                                        HorizontalOptions="End"
                                        VerticalOptions="End"
                                        Margin="0,0,-2,-2"
                                        IsVisible="{Binding IsOnline}"/>
                            </Grid>

                            <VerticalStackLayout Spacing="2" VerticalOptions="End">

                                <Label Text="{Binding SenderDisplayName}"
                                   FontSize="10"
                                   TextColor="Gray"
                                   Margin="2,0,2,0"
                                   HorizontalOptions="{Binding Alignment}"/>

                                <Border BackgroundColor="{Binding BubbleColor}"
                                            StrokeShape="RoundRectangle 18,18,18,2"
                                        StrokeThickness="0"
                                        Padding="15,10"
                                        MaximumWidthRequest="260">
                                    <Label Text="{Binding Content}" 
                                           TextColor="{Binding TextColor}" 
                                           FontSize="15"/>
                                </Border>

                                <HorizontalStackLayout Spacing="4" HorizontalOptions="{Binding Alignment}">
                                    <Label Text="{Binding StatusText}" 
                                           FontSize="10" 
                                           TextColor="Gray" 
                                           IsVisible="{Binding IsMine}"/>
                                    <Label Text="{Binding MessageSent, StringFormat='{0:t}'}" 
                                           FontSize="10" 
                                           TextColor="#999"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <Grid VerticalOptions="End" IsVisible="{Binding IsMine}">
                                <Border StrokeShape="Ellipse"
                                        HeightRequest="40"
                                        WidthRequest="40"
                                        StrokeThickness="0"
                                        BackgroundColor="#E0E0E0">
                                    <Image Aspect="AspectFill" HeightRequest="40" WidthRequest="40">
                                        <Image.Source>
                                            <UriImageSource Uri="{Binding SenderImageUrl}" 
                                                            CachingEnabled="True" 
                                                            CacheValidity="14:00:00:00"/>
                                        </Image.Source>
                                    </Image>
                                </Border>
                            </Grid>

                        </HorizontalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="1" StrokeThickness="0" BackgroundColor="White" Padding="10" Shadow="{Shadow Brush=Black, Opacity=0.1, Radius=5, Offset='0,-5'}">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                <Border Grid.Column="0" Stroke="#E0E0E0" StrokeShape="RoundRectangle 25" HeightRequest="55" Padding="15,0" BackgroundColor="#F9F9F9">
                    <!-- Slight height increase for visibility -->
                    <Entry Text="{Binding NewMessageContent}" 
                           Placeholder="Type a message..." 
                           TextColor="Black" 
                           PlaceholderColor="Gray"
                           VerticalOptions="Center"
                           ReturnType="Send"
                           ReturnCommand="{Binding SendMessageCommand}"/>
                </Border>
                <Button Grid.Column="1" 
                        Text="Send" 
                        Command="{Binding SendMessageCommand}" 
                        BackgroundColor="#5243E4" 
                        TextColor="White" 
                        CornerRadius="25" 
                        HeightRequest="50" 
                        WidthRequest="70"
                        FontAttributes="Bold"/>
            </Grid>
        </Border>

    </Grid>
</ContentPage>